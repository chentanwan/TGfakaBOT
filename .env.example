# Telegram
BOT_TOKEN=
ADMIN_IDS=123456789
BOT_LANGUAGE=zh
SUPPORT_URL=https://t.me/your_support

# PostgreSQL
POSTGRES_DB=tgfakabot
POSTGRES_USER=tgfakabot
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://tgfakabot:change-me@postgres:5432/tgfakabot

# Redis (optional but enabled by Compose)
REDIS_URL=redis://redis:6379/0

# Card-secret protection (generate independent random values)
# CARD_ENCRYPTION_KEY must be urlsafe-base64 encoded 32 bytes (Fernet.generate_key())
CARD_ENCRYPTION_KEY=
CARD_FINGERPRINT_KEY=
ORDER_RESERVATION_MINUTES=15

# Runtime
TZ=Asia/Shanghai
LOG_LEVEL=INFO
