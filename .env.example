# ==================== Telegram Bot ====================
# Telegram BotFather 创建机器人后获得的 Token；必填，属于敏感信息。
BOT_TOKEN=
# 管理员 Telegram 数字用户 ID；多个管理员用英文逗号分隔，例如 123,456。
ADMIN_IDS=123456789
# Bot 默认界面语言；当前主要支持 zh。
BOT_LANGUAGE=zh
# 客服链接；用于 /support、支付异常和用户求助提示。
SUPPORT_URL=https://t.me/cclchat_bot

# ==================== PostgreSQL ====================
# Docker Compose 创建的 PostgreSQL 数据库名称。
POSTGRES_DB=tgfakabot
# Docker Compose 创建的 PostgreSQL 用户名。
POSTGRES_USER=tgfakabot
# PostgreSQL 密码；生产环境必须更换为高强度随机值。
POSTGRES_PASSWORD=change-me
# Bot 使用的 SQLAlchemy 异步数据库连接串；Compose 内主机名通常为 postgres。
DATABASE_URL=postgresql+asyncpg://tgfakabot:change-me@postgres:5432/tgfakabot

# ==================== Redis ====================
# Redis 连接串；用于 Telegram FSM、管理员一次性确认令牌等临时状态。
REDIS_URL=redis://redis:6379/0

# ==================== 卡密与订单安全 ====================
# Fernet 主加密密钥；必须是 urlsafe-base64 编码的 32 字节随机值。
# 可通过 Python 的 Fernet.generate_key() 生成；丢失后已有卡密无法解密。
CARD_ENCRYPTION_KEY=
# 卡密去重指纹密钥；请使用独立的高强度随机字符串，不要与加密密钥相同。
CARD_FINGERPRINT_KEY=
# 未付款订单预留库存的分钟数；到期且无支付记录时自动释放库存。
ORDER_RESERVATION_MINUTES=15

# ==================== 插件系统 ====================
# 要加载的插件 Python 模块；多个模块用英文逗号分隔，留空则禁用全部插件。
PLUGIN_MODULES=plugins.bepusdt,plugins.prodseller
# 插件 HTTP 回调服务监听地址；容器环境通常使用 0.0.0.0。
PLUGIN_HTTP_HOST=0.0.0.0
# 插件 HTTP 回调服务监听端口；需与反向代理和 Compose 端口映射一致。
PLUGIN_HTTP_PORT=8081

# ==================== BEpusdt 支付插件 ====================
# 自建 BEpusdt 网关地址，不要以 / 结尾；生产环境建议使用 HTTPS。
BEPUSDT_BASE_URL=https://pay.example.com
# BEpusdt 后台生成的 API 对接令牌；敏感信息，只应写入真实 .env 或密钥管理器。
BEPUSDT_API_TOKEN=
# 外网可访问的 Bot 插件回调根地址；必须使用 HTTPS，不包含回调路径。
BEPUSDT_PUBLIC_BASE_URL=https://bot-payments.example.com
# BEpusdt 交易网络；usdt.trc20 表示 TRON 网络 USDT。
BEPUSDT_TRADE_TYPE=usdt.trc20
# BEpusdt 商品法币计价币种；本项目上游商品统一使用 USD。
BEPUSDT_FIAT=USD
# BEpusdt 收银台订单有效期，单位秒；应不小于网关允许的最低值。
BEPUSDT_TIMEOUT_SECONDS=900

# ==================== ProdSeller 供货商插件 ====================
# ProdSeller API Key；敏感信息，不要提交到 Git，建议定期轮换。
PRODSELLER_API_KEY=
# ProdSeller API v1 根地址；除非使用兼容代理，否则无需修改。
PRODSELLER_BASE_URL=https://prodseller.com/v1
# ProdSeller 成本与本地销售价格币种；当前固定按 USD 美分保存。
PRODSELLER_CURRENCY=USD
# 比例利润百分比；20 表示在上游成本上增加 20%。每个供货商使用独立前缀配置。
PRODSELLER_PROFIT_PERCENT=20
# 固定利润，单位为美元；1.50 表示在比例利润之外再增加 1.50 USD。
PRODSELLER_PROFIT_FIXED=0.00
# 上游商品目录自动同步频率，单位分钟；默认每 60 分钟同步价格和库存。
PRODSELLER_PRODUCT_SYNC_MINUTES=60
# 已付款但尚未交付的上游订单查询频率，单位秒；默认每 30 秒查询一次。
PRODSELLER_ORDER_POLL_SECONDS=30

# ==================== 运行环境 ====================
# 容器和日志使用的时区；建议使用有效 IANA 时区名称。
TZ=Asia/Shanghai
# Python 日志级别；常用值为 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO
