# Telegram
BOT_TOKEN=
ADMIN_IDS=123456789
BOT_LANGUAGE=zh
SUPPORT_URL=https://t.me/cclchat_bot

# PostgreSQL
POSTGRES_DB=tgfakabot
POSTGRES_USER=tgfakabot
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://tgfakabot:change-me@postgres:5432/tgfakabot

# Redis (optional but enabled by Compose)
REDIS_URL=redis://redis:6379/0

# Card-secret protection (generate independent random values)
# CARD_ENCRYPTION_KEY must be urlsafe-base64 encoded 32 bytes (Fernet.generate_key())
CARD_ENCRYPTION_KEY=
CARD_FINGERPRINT_KEY=
ORDER_RESERVATION_MINUTES=15

# Optional plugins (comma-separated Python modules)
PLUGIN_MODULES=plugins.bepusdt
PLUGIN_HTTP_HOST=0.0.0.0
PLUGIN_HTTP_PORT=8081

# BEpusdt plugin (self-hosted gateway)
BEPUSDT_BASE_URL=https://pay.example.com
BEPUSDT_API_TOKEN=
BEPUSDT_PUBLIC_BASE_URL=https://bot-payments.example.com
BEPUSDT_TRADE_TYPE=usdt.trc20
BEPUSDT_FIAT=CNY
BEPUSDT_TIMEOUT_SECONDS=900

# Runtime
TZ=Asia/Shanghai
LOG_LEVEL=INFO
